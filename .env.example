# CEET - Vercel / Local
JWT_SECRET=gere-uma-chave-forte-e-secreta

# Vercel: cole aqui o JSON completo da nova Service Account.
# NÃO coloque esse valor no GitHub. Cadastre-o em Vercel > Settings > Environment Variables.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Opcional: caminho local para a Service Account
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\firebase-service-account.json

# Configuração Web já está em firebase-applet-config.json
